nav a[aria-current]{border-color:var(--bronze)}
.hero{min-height:88vh;display:flex;flex-direction:column;justify-content:flex-end;padding:14vh 6vw 9vh;background:linear-gradient(180deg,rgba(15,19,22,.4),rgba(15,19,22,.95)),url(photos/omsk.jpg) center/cover #1b2226}
h1{margin:0 0 1.2rem;max-width:12ch;font-size:clamp(2.8rem,10vw,6.5rem);line-height:1.02}
.lead{margin:0;max-width:34ch;color:var(--bronze);font-size:1.3rem}
.btn{align-self:flex-start;margin-top:2rem;padding:.8rem 1.4rem;background:var(--accent);color:#06201A;font:600 1rem system-ui,sans-serif;text-decoration:none;border-radius:4px}
main{max-width:1000px;margin:0 auto;padding:6rem 6vw}
h2{margin:0 0 1rem;font-size:2rem}
main p{max-width:62ch}
.cats{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem;margin-top:2.5rem}
.cats a{display:block;padding:1.4rem;background:var(--panel);border-left:4px solid var(--accent);color:inherit;text-decoration:none}
.cats b{display:block;font-size:1.2rem}
.cats span{color:var(--mute);font-size:.95rem}
footer{padding:2rem 6vw;border-top:1px solid var(--line);color:var(--mute);font:.95rem system-ui,sans-serif}
